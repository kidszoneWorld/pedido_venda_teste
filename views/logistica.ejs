<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Acompanhamento de entrega</title>

    <link
        rel="apple-touch-icon"
        sizes="180x180"
        href="/images/apple-touch-icon.png"
    >

    <link
        rel="icon"
        type="image/png"
        sizes="32x32"
        href="/images/favicon-32x32.png"
    >

    <link
        rel="icon"
        type="image/png"
        sizes="16x16"
        href="/images/favicon-16x16.png"
    >

    <link
        rel="manifest"
        href="/images/site.webmanifest"
    >

    <script
        src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"
    ></script>

    <link
        rel="stylesheet"
        href="/css/logistica.css?v=1783967913336"
    >

    <link
        rel="stylesheet"
        href="/css/theme-toggle.css?v=1783967913336"
    >

    <script>
        (function () {
            const savedTheme =
                localStorage.getItem('theme') ||
                'light';

            document.documentElement.classList.add(
                savedTheme + '-theme'
            );
        })();
    </script>
</head>

<body>
    <div class="container">
        <%- include('header') %>

        <div class="header">
            <header class="header-container">
                <div class="header-left">
                    <div class="header-logo">
                        <a href="/">
                            <img
                                class="img_link"
                                src="/images/logo.png"
                                alt="KidsZone"
                            >
                        </a>
                    </div>

                    <h3 class="header-title">
                        Acompanhamento de entrega
                    </h3>

                    <!-- <label class="theme-switch">
                        <input
                            type="checkbox"
                            id="themeToggle"
                        >

                        <span class="slider"></span>
                    </label> -->
                </div>

                <div class="header-right">
                    <!-- <h4>
                        Região selecionada:
                        <br>

                        <strong id="regiaoAtualTexto">
                            Todas as regiões
                        </strong>
                    </h4> -->
                </div>
            </header>
        </div>

        <div class="sairExcel">
            <img
                class="img_link_excel"
                src="/images/excel.png"
                alt="Exportar para Excel"
                id="exportExcel"
                title="Exportar dados exibidos para Excel"
                role="button"
                tabindex="0"
            >
        </div>

        <div
            id="feedback"
            style="
                display: none;
                text-align: center;
                font-weight: bold;
                margin: 10px;
                color: red;
            "
            role="status"
            aria-live="polite"
        ></div>

        <div id="filters">
            <div class="menu-toggle">
                <button
                    id="menuToggle"
                    class="menu-button"
                    type="button"
                >
                    <span class="menu-icon">☰</span>
                    Filtros
                </button>
            </div>

            <div
                class="filter-container"
                id="filterContainer"
            >
                <div class="filter-inputs">
                    <div class="filter-row filter-row-top">
                        <!-- <div class="filter-item">
                            <label for="regiaoFilter">
                                Região:
                            </label>

                            <select id="regiaoFilter">
                                <option value="todas">
                                    Todas
                                </option>

                                <option value="sul-sudeste">
                                    Sul/Sudeste
                                </option>

                                <option value="norte-nordeste-centro-oeste">
                                    Norte/Nordeste/Centro-Oeste
                                </option>
                            </select>
                        </div> -->

                        <div class="filter-item">
                            <label for="representanteFilter">
                                Cód Rep:
                            </label>

                            <input
                                type="text"
                                id="representanteFilter"
                                placeholder="Ex.: 37"
                                inputmode="numeric"
                                autocomplete="off"
                            >
                        </div>

                        <div class="filter-item">
                            <label for="notaFilter">
                                Nota Fiscal:
                            </label>

                            <input
                                type="text"
                                id="notaFilter"
                                placeholder="Ex.: 36777"
                                inputmode="numeric"
                                autocomplete="off"
                            >
                        </div>

                        <div class="filter-item">
                            <label for="clienteCNPJFilter">
                                Cliente CNPJ:
                            </label>

                            <input
                                type="text"
                                id="clienteCNPJFilter"
                                placeholder="Ex.: 08712676000110"
                                inputmode="numeric"
                                autocomplete="off"
                            >
                        </div>
                    </div>

                    <div class="filter-row filter-row-bottom">
                        <div class="filter-item">
                            <label for="dataPedidoInicioFilter">
                                Data emissão, início:
                            </label>

                            <input
                                type="date"
                                id="dataPedidoInicioFilter"
                            >
                        </div>

                        <div class="filter-item">
                            <label for="dataPedidoFimFilter">
                                Data emissão, fim:
                            </label>

                            <input
                                type="date"
                                id="dataPedidoFimFilter"
                            >
                        </div>

                        <div class="filter-item">
                            <label for="statusFilter">
                                Status:
                            </label>

                            <select id="statusFilter">
                                <option value="todos">
                                    Todos
                                </option>

                                <option value="entregue">
                                    Entregue
                                </option>

                                <option value="pendente">
                                    Pendente
                                </option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="filter-buttons">
                    <button
                        id="applyFilters"
                        type="button"
                    >
                        Aplicar filtros
                    </button>

                    <button
                        id="clearFilters"
                        type="button"
                    >
                        Limpar filtros
                    </button>
                </div>
            </div>
        </div>

        <div class="resumo-logistica">
            <!-- <span>
                Registros:
                <strong id="totalRegistros">0</strong>
            </span> -->
        </div>

        <div class="table-container">
            <table id="order-table">
                <thead>
                    <tr>
                        <!-- <th class="regiao">
                            Região
                        </th> -->

                        <th class="dataEmissao">
                            Data da emissão
                        </th>

                        <th class="numNotas">
                            Núm nota
                        </th>

                        <th class="codCliente">
                            Cód Cliente
                        </th>

                        <th class="cliente">
                            Cliente
                        </th>

                        <th class="clienteCNPJ">
                            Cliente CNPJ
                        </th>

                        <th class="uf">
                            UF
                        </th>

                        <th class="codRep">
                            Cód Rep
                        </th>

                        <th class="codTrans">
                            Cód Trans
                        </th>

                        <th class="transportadora">
                            Transportadora
                        </th>

                        <th class="saida">
                            Saída
                        </th>

                        <th class="previsaoEntrega">
                            Previsão de Entrega
                        </th>

                        <th class="dataEntrega">
                            Data de Entrega
                        </th>

                        <th class="statusEntrega">
                            Status Entrega
                        </th>

                        <th class="agenda">
                            Agenda
                        </th>

                        <th class="ocorrencia">
                            Ocorrência
                        </th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>
    </div>

    <script src="/logistica.js?v=1783967913336"></script>
    <script src="/theme-toggle.js?v=1783967913336"></script>
</body>

</html>