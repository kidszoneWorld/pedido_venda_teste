    <link rel="stylesheet" href="/css/styles2.css">
    <link rel="stylesheet" href="/estoque.css">


    <link rel="stylesheet" href="/css/theme-toggle.css">
    <!-- Script inline para aplicar o tema imediatamente -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.classList.add(
                savedTheme + '-theme'
            );
        })();
    </script>

</head>
<style id="coresEstoque">
    table#dadosPedido tbody tr.estoque-baixo > td {
        background: #f8d7da !important;
        background-color: #f8d7da !important;
        color: #842029 !important;
    }

    table#dadosPedido tbody tr.estoque-medio > td {
        background: #fff3cd !important;
        background-color: #fff3cd !important;
        color: #664d03 !important;
    }

    table#dadosPedido tbody tr.estoque-alto > td {
        background: #d1e7dd !important;
        background-color: #d1e7dd !important;
        color: #0f5132 !important;
    }

    table#dadosPedido tbody tr.estoque-baixo .codigo-item,
    table#dadosPedido tbody tr.estoque-baixo .descricao-item {
